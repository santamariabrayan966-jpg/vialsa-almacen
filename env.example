SPRING_PROFILES_ACTIVE=dev

# Base de datos exclusiva de DentIA. El nombre fisico queda fijado a "dentia".
DENTIA_DB_HOST=localhost
DENTIA_DB_PORT=3306
DENTIA_DB_USERNAME=root
DENTIA_DB_PASSWORD=
DENTIA_DB_SSL_MODE=REQUIRED

# Inicializacion unica y temporal del primer administrador
DENTIA_BOOTSTRAP_ADMIN_ENABLED=false
DENTIA_BOOTSTRAP_ADMIN_USERNAME=
DENTIA_BOOTSTRAP_ADMIN_PASSWORD=

# Claves independientes y aleatorias, nunca versionadas. En prod la de
# recuperación es obligatoria (mínimo 32 caracteres).
DENTIA_PASSWORD_RESET_KEY=
DENTIA_REMEMBER_ME_KEY=
DENTIA_SECURITY_COOKIES_SECURE=false

# Debe permanecer desactivado: evita procesos automaticos de tienda/inventario heredados.
DENTIA_LEGACY_COMMERCE_ENABLED=false
DENTIA_AGENDA_INTERVALO_MINUTOS=10

# Integraciones opcionales
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MIAPI_TOKEN=
APISPERU_TOKEN=
DOCUMENTO_PROVIDER=apisperu

# Correo
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_TRUST=smtp.gmail.com
